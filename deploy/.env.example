# Variables for the local Docker stack (deploy/docker-compose.yml).
# This file is also mounted into the PHP container as the app's /srv/.env,
# so it must also contain the MYSQL_* variables read by settings.php.
#
# Copy this file to .env (in this deploy/ directory) and set your own values.
# Never commit the real .env.

# MariaDB root password (container administration only)
MYSQL_ROOT_PASSWORD=

# Application database credentials (shared by MariaDB and Drupal)
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=

# Host Drupal uses to reach the database (the compose service name)
MYSQL_HOST=mariadb
