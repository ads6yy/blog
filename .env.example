# Environment variables loaded by load.environment.php (vlucas/phpdotenv)
# and consumed by web/sites/default/settings.php for the database connection.
#
# Copy this file to .env and set your own values. Never commit the real .env.

# Database name
MYSQL_DATABASE=drupal

# Database credentials
MYSQL_USER=drupal
MYSQL_PASSWORD=

# Host Drupal uses to reach the database.
# - Docker stack (deploy/docker-compose.yml): the service name "mariadb"
# - Local MySQL/MariaDB: "127.0.0.1"
MYSQL_HOST=mariadb
