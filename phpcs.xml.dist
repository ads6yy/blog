<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="perso">
  <description>Coding standards for the project's custom PHP code.</description>

  <!-- Only the code we own. -->
  <file>web/modules/custom</file>
  <file>web/themes/perso</file>

  <!-- Never sniff dependencies or build artefacts. -->
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>web/themes/perso/assets/*</exclude-pattern>
  <exclude-pattern>web/themes/perso/build/*</exclude-pattern>

  <arg name="extensions" value="php,module,inc,install,theme,profile"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
